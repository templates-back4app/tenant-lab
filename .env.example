# Copy to .env and fill in. Never commit .env. Scripts never print these values.
#
# Phase A runs everything locally: `npm run dev:server` starts a parse-server with FIXED local keys
# (scripts/lib/env.mjs LOCAL — they are not secrets, the server only listens on localhost and the database is a
# throwaway), so an empty .env is fine for local work. These variables are only read when you later point the
# scripts and tests at a Back4app backend (Phase A live run — do not do it from this repo until the coordinator
# says so).
#
# Back4app → your backend app → App Settings → Security & Keys.
# MASTER_KEY is OPTIONAL even then: scripts/setup.mjs falls back to the Cloud function setupSchema (REST key,
# guarded by cloud/config.js SETUP_ENABLED) when the key is absent. The master key never needs to leave the dashboard.
APP_ID=
JS_KEY=
REST_KEY=
MASTER_KEY=
SERVER_URL=https://parseapi.back4app.com

# Local development only: Postgres database used by the local parse-server (port 5433, brew postgresql@17).
DATABASE_URL=postgres://localhost:5433/tenant_dev

# Point the test suite at another server (e.g. the live backend, later) instead of the in-process local one.
# TEST_SERVER_URL=https://parseapi.back4app.com
